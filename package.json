    "check:viasocket": "node viasocket-check.mjs server public",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
