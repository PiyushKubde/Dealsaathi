{
  "name": "dealsaathi",
  "version": "0.1.0",
  "private": true,
  "description": "DealSaathi — AI-powered real estate assistant for brokers and property managers, built on viaSocket.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
