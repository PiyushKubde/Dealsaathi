# Copy this file to .env and fill in the values.
# Find them in viaSocket -> Integrations -> your embed -> Install Code.
VIASOCKET_ORG_ID=your-org-id
VIASOCKET_PROJECT_ID=your-project-id
# Server only. Never put this in frontend code, screenshots or logs.
VIASOCKET_EMBED_SECRET=your-embed-signing-secret
PORT=3000
# Only needed when the app is hosted (e.g. on Embarko). At least 12 characters.
# Locally you can leave it out: the app then only listens on this computer.
APP_PASSWORD=
