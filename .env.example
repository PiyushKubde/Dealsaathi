# Copy to .env (never commit .env). All values are read server-side only.

# Login for the DealSaathi workspace owner. Required: without it nobody can sign in.
DEALSAATHI_ADMIN_EMAIL=broker@example.com
DEALSAATHI_ADMIN_PASSWORD=change-me-to-a-long-password
DEALSAATHI_ADMIN_NAME=Workspace Owner

# viaSocket embed (viaSocket → Integrations → the embed → Install Code).
VIASOCKET_ORG_ID=53645
VIASOCKET_PROJECT_ID=projwZ9V7Wb3
# Server-side only. Never in client code, a committed file or a log line.
VIASOCKET_EMBED_SECRET=

# Optional: AI model for the assistant (names from viaSocket's ai.md). Leave both empty for viaSocket's default.
VIASOCKET_AI_SERVICE=
VIASOCKET_AI_MODEL=

# Optional: default time zone for viewings (must be one Google Calendar's Create Event accepts).
DEALSAATHI_TIMEZONE=Asia/Kolkata

# Local only. Embarko sets PORT and DATA_DIR itself.
PORT=3000
DATA_DIR=./data
